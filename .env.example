# ===== 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）=====

# DeepSeek（LLM：规划/审查节点 + 查询改写）
DEEPSEEK_API_KEY=

# DashScope（仅 Embedding：text-embedding-v3，1024 维）
DASHSCOPE_API_KEY=

# 高德：Web 服务 key（后端 POI/路线）+ JS API key（前端地图）
AMAP_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# 天气服务（心知天气）
SENIVERSE_API_KEY=

# PostgreSQL（pgvector）
POSTGRES_DB=startrip
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
DATABASE_URL=postgresql://user:pass@localhost:5432/startrip

# Redis
REDIS_URL=redis://localhost:6379/0

# 可靠性（超时 / 重试 / 熔断；不填用默认值）
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_FALLBACK_MODEL=
EMBED_TIMEOUT=20
TOOL_TIMEOUT=8
TOOL_MAX_RETRIES=2
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT=30

# JWT 鉴权
JWT_SECRET=
